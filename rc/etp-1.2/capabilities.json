{
  "$comment": [
    "The capabilities of ETP v1.2: what each one is, where it applies, its type,",
    "unit, bounds and default. None of this is in the .avsc schemas -- a capability",
    "travels as a map of DataValue -- so it is declared here, from the specification.",
    "Source: ETP Specification v1.2 / Document v1.1, sections 3.3.2, 4.3 and 5.2.3,",
    "and chapter 23 (23.3 DataObjectCapabilityKind, 23.4 EndpointCapabilityKind,",
    "23.5 ProtocolCapabilityKind).",
    "`kinds` copies the three Avro enumerations of chapter 23 verbatim; `capabilities`",
    "is read from the prose tables. The test capability_table_matches_the_kind_enums",
    "(crates/retp-proto/tests/etp_session.rs) holds one against the other: two parts of",
    "the specification, compared.",
    "`combine` states a rule the specification gives for combining two values:",
    "  smallerOfTwo     -- the session uses the smaller of the client's and the server's;",
    "  objectOverrides  -- a data object's value overrides the endpoint's, and a",
    "                      protocol's value may lower it but never raise it.",
    "`conflicts` records where the specification contradicts itself, and which value",
    "is used, and why."
  ],
  "kinds": {
    "endpoint": [
      "ActiveTimeoutPeriod",
      "AuthorizationDetails",
      "ChangePropagationPeriod",
      "ChangeRetentionPeriod",
      "MaxConcurrentMultipart",
      "MaxDataObjectSize",
      "MaxPartSize",
      "MaxSessionClientCount",
      "MaxSessionGlobalCount",
      "MaxWebSocketFramePayloadSize",
      "MaxWebSocketMessagePayloadSize",
      "MultipartMessageTimeoutPeriod",
      "ResponseTimeoutPeriod",
      "SupportsAlternateRequestUris",
      "SupportsMessageHeaderExtensions",
      "RequestSessionTimeoutPeriod",
      "SessionEstablishmentTimeoutPeriod"
    ],
    "protocol": [
      "FrameChangeDetectionPeriod",
      "MaxDataArraySize",
      "MaxDataObjectSize",
      "MaxFrameResponseRowCount",
      "MaxIndexCount",
      "MaxRangeChannelCount",
      "MaxRangeDataItemCount",
      "MaxResponseCount",
      "MaxStreamingChannelsSessionCount",
      "MaxSubscriptionSessionCount",
      "MaxTransactionCount",
      "TransactionTimeoutPeriod",
      "SupportsSecondaryIndexFiltering"
    ],
    "dataObject": [
      "ActiveTimeoutPeriod",
      "MaxContainedDataObjectCount",
      "MaxDataObjectSize",
      "OrphanedChildrenPrunedOnDelete",
      "SupportsGet",
      "SupportsPut",
      "SupportsDelete",
      "MaxSecondaryIndexCount"
    ]
  },
  "capabilities": [
    { "name": "ActiveTimeoutPeriod", "scopes": ["endpoint", "dataObject"], "type": "long", "unit": "seconds", "min": 60, "default": 3600, "combine": "objectOverrides", "section": "3.3.2.1" },
    { "name": "AuthorizationDetails", "scopes": ["endpoint"], "type": "ArrayOfString", "unit": "", "section": "5.2.3" },
    { "name": "ChangePropagationPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "min": 1, "max": 600, "default": 5, "section": "3.3.2.2" },
    { "name": "ChangeRetentionPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "min": 86400, "default": 86400, "section": "23.4" },
    { "name": "MaxConcurrentMultipart", "scopes": ["endpoint"], "type": "long", "unit": "messages", "min": 1, "section": "3.7.3.1.1.1" },
    { "name": "MaxDataObjectSize", "scopes": ["endpoint", "protocol", "dataObject"], "type": "long", "unit": "bytes", "min": 100000, "combine": "objectOverrides", "section": "3.3.2.4" },
    { "name": "MaxPartSize", "scopes": ["endpoint"], "type": "long", "unit": "bytes", "min": 10000, "section": "3.3.2.5" },
    { "name": "MaxSessionClientCount", "scopes": ["endpoint"], "type": "long", "unit": "sessions", "min": 2, "section": "3.3.2.6" },
    { "name": "MaxSessionGlobalCount", "scopes": ["endpoint"], "type": "long", "unit": "sessions", "min": 2, "section": "3.3.2.7" },
    { "name": "MaxWebSocketFramePayloadSize", "scopes": ["endpoint"], "type": "long", "unit": "bytes", "default": 4194304, "combine": "smallerOfTwo", "section": "3.3.2.8, 4.3" },
    { "name": "MaxWebSocketMessagePayloadSize", "scopes": ["endpoint"], "type": "long", "unit": "bytes", "default": 16777216, "combine": "smallerOfTwo", "section": "3.3.2.9, 4.3" },
    { "name": "MultipartMessageTimeoutPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "max": 60, "section": "3.7.3.1.1.2" },
    { "name": "ResponseTimeoutPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "min": 60, "default": 300, "section": "3.3.2.3" },
    { "name": "SupportsAlternateRequestUris", "scopes": ["endpoint"], "type": "boolean", "unit": "", "default": false, "section": "3.7.4.1" },
    { "name": "SupportsMessageHeaderExtensions", "scopes": ["endpoint"], "type": "boolean", "unit": "", "default": false, "section": "3.6.2" },
    { "name": "RequestSessionTimeoutPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "min": 5, "default": 45, "section": "3.3.2.10, 5.2.3" },
    { "name": "SessionEstablishmentTimeoutPeriod", "scopes": ["endpoint"], "type": "long", "unit": "seconds", "min": 5, "default": 60, "section": "5.2.3, 23.4" },

    { "name": "FrameChangeDetectionPeriod", "scopes": ["protocol"], "type": "long", "unit": "seconds", "min": 1, "max": 600, "default": 60, "section": "23.5" },
    { "name": "MaxDataArraySize", "scopes": ["protocol"], "type": "long", "unit": "bytes", "min": 100000, "section": "23.5" },
    { "name": "MaxFrameResponseRowCount", "scopes": ["protocol"], "type": "long", "unit": "rows", "min": 100000, "section": "23.5" },
    { "name": "MaxIndexCount", "scopes": ["protocol"], "type": "long", "unit": "indexes", "min": 1, "default": 100, "section": "23.5" },
    { "name": "MaxRangeChannelCount", "scopes": ["protocol"], "type": "long", "unit": "channels", "section": "23.5" },
    { "name": "MaxRangeDataItemCount", "scopes": ["protocol"], "type": "long", "unit": "records", "min": 1000000, "section": "23.5" },
    { "name": "MaxResponseCount", "scopes": ["protocol"], "type": "long", "unit": "responses", "min": 10000, "combine": "smallerOfTwo", "section": "3.7.3.1 §4.e, 23.5" },
    { "name": "MaxStreamingChannelsSessionCount", "scopes": ["protocol"], "type": "long", "unit": "channels", "min": 10000, "section": "23.5" },
    { "name": "MaxSubscriptionSessionCount", "scopes": ["protocol"], "type": "long", "unit": "subscriptions", "min": 100, "section": "23.5" },
    { "name": "MaxTransactionCount", "scopes": ["protocol"], "type": "long", "unit": "transactions", "min": 1, "max": 1, "default": 1, "section": "23.5" },
    { "name": "TransactionTimeoutPeriod", "scopes": ["protocol"], "type": "long", "unit": "seconds", "min": 5, "section": "23.5" },
    { "name": "SupportsSecondaryIndexFiltering", "scopes": ["protocol"], "type": "boolean", "unit": "", "default": false, "section": "23.5" },

    { "name": "MaxContainedDataObjectCount", "scopes": ["dataObject"], "type": "long", "unit": "objects", "section": "23.3" },
    { "name": "OrphanedChildrenPrunedOnDelete", "scopes": ["dataObject"], "type": "boolean", "unit": "", "default": false, "section": "23.3" },
    { "name": "SupportsGet", "scopes": ["dataObject"], "type": "boolean", "unit": "", "default": true, "section": "23.3" },
    { "name": "SupportsPut", "scopes": ["dataObject"], "type": "boolean", "unit": "", "default": true, "section": "23.3" },
    { "name": "SupportsDelete", "scopes": ["dataObject"], "type": "boolean", "unit": "", "default": true, "section": "23.3" },
    { "name": "MaxSecondaryIndexCount", "scopes": ["dataObject"], "type": "long", "unit": "indexes", "min": 1, "default": 1, "section": "23.3" }
  ],
  "conflicts": [
    {
      "name": "SessionEstablishmentTimeoutPeriod",
      "field": "default",
      "values": { "3.3.2.11": 3600, "5.2.3": 60, "23.4": 60 },
      "used": 60,
      "why": "Two of the three places say 60, among them the Core protocol's own capability table (5.2.3); a shorter wait is also the one that cannot leave a peer hanging for an hour."
    }
  ]
}
